# Copier ce fichier en .env puis adapter les valeurs
PORT=3000

# MongoDB local : mongodb://127.0.0.1:27017/decoar
# MongoDB Atlas : mongodb+srv://<user>:<motdepasse>@<cluster>.mongodb.net/decoar
MONGODB_URI=mongodb://127.0.0.1:27017/decoar

# Optionnel : serveurs DNS pour Atlas si "querySrv ECONNREFUSED" (par defaut 8.8.8.8,1.1.1.1 si besoin)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Cle secrete pour signer les jetons JWT (mettre une longue chaine aleatoire)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# ---- E-mails (codes de verification et mot de passe oublie)
# Rien de configure : le code s'affiche dans ce terminal ([MAIL] ...), pratique pour tester.
# Gmail (en local) : compte Google > Securite > Validation en 2 etapes > Mots de passe des applications
# SMTP_USER=ton.adresse@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Brevo (en ligne, Render bloque le SMTP) : brevo.com > SMTP & API > Cles API ; MAIL_FROM = expediteur verifie
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=ton.adresse@gmail.com
# Forcer un fournisseur : console | smtp | brevo
# MAIL_PROVIDER=console

# ---- Reconnaissance faciale (service Python face-service/, OpenCV)
# FACE_SERVICE_URL=http://127.0.0.1:5001
# FACE_SERVICE_KEY=          (meme valeur que dans face-service, obligatoire en ligne)
# FACE_MATCH_THRESHOLD=0.4   (similarite minimale pour reconnaitre un visage)
# Defi de mouvements (detection du vivant)
# FACE_CHALLENGE_MOVES=left,right,up,down
# FACE_YAW_DELTA=0.2         (tourner la tete : variation minimale du yaw)
# FACE_PITCH_DELTA=0.12      (lever / baisser la tete : variation minimale du pitch)
# FACE_CENTER_MAX_YAW=0.2    (tolerance pour "de face")
